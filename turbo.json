{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "eslint.config.js", ".nvmrc"],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "migrations/**", "tsconfig*.json", "package.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "tsconfig*.json", "package.json"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "*.ts", "*.js", "tsconfig*.json", "package.json"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NATS_URL"],
      "inputs": ["src/**", "migrations/**", "*.ts", "tsconfig*.json", "package.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
