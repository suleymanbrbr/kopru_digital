{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["pnpm-lock.yaml", "eslint.config.js", ".nvmrc"],
  "globalEnv": ["CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "migrations/**",
        "public/**",
        "scripts/**",
        "*.config.*",
        "tsconfig*.json",
        "package.json"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NEXT_PUBLIC_*", "API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "e2e/**",
        "ekran/**",
        "*.ts",
        "*.js",
        "*.mjs",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "scripts/**",
        "e2e/**",
        "ekran/**",
        "*.ts",
        "*.js",
        "*.mjs",
        "tsconfig*.json",
        "package.json"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["DATABASE_URL", "NATS_URL"],
      "inputs": ["src/**", "migrations/**", "scripts/**", "*.ts", "tsconfig*.json", "package.json"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
