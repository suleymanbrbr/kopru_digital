    "/v1/bildirim/cihazlar": {
      "put": {
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "cihaz_kimligi": {
                    "maxLength": 200,
                    "minLength": 1,
                    "type": "string"
                  },
                  "dil": {
                    "maxLength": 10,
                    "minLength": 2,
                    "type": "string"
                  },
                  "platform": {
                    "enum": [
                      "ios",
                      "android",
                      "web"
                    ],
                    "type": "string"
                  },
                  "push_belirteci": {
                    "maxLength": 500,
                    "minLength": 1,
                    "type": "string"
                  },
                  "uygulama_surumu": {
                    "maxLength": 50,
                    "type": "string"
                  }
                },
                "required": [
                  "platform",
                  "push_belirteci",
                  "cihaz_kimligi"
                ],
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "aktif": {
                      "type": "boolean"
                    },
                    "cihaz_kimligi": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cihaz_kimligi",
                    "aktif"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Push cihazini kaydeder ya da gunceller (her uygulama acilisinda). Ayni belirtec baska kullanicidaysa onun kaydi pasiflenir.",
        "tags": [
          "bildirim"
        ]
      }
    },
    "/v1/bildirim/cihazlar/{cihaz_kimligi}": {
      "delete": {
        "parameters": [
          {
            "in": "path",
            "name": "cihaz_kimligi",
            "required": true,
            "schema": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": false,
                  "properties": {
                    "aktif": {
                      "type": "boolean"
                    },
                    "cihaz_kimligi": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cihaz_kimligi",
                    "aktif"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "Default Response"
          }
        },
        "summary": "Cikista cihaz kaydini siler (kayit yoksa da basarili).",
        "tags": [
          "bildirim"
        ]
      }
    },
