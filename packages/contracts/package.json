{
  "name": "@kopru/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Servisler arasi sozlesmeler: olay zarfi, olay tanimlari, hata yaniti",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kopru/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
