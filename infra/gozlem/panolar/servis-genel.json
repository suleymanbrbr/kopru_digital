{
  "uid": "kopru-servis-genel",
  "title": "Köprü / Servis genel (RED)",
  "description": "İstek hızı, hata oranı ve gecikme. Rota şablonuyla gruplanır; kurum/kişi etiketi yoktur. Alarmlar: KopruP95Gecikme*, Kopru5xxOrani*.",
  "tags": ["kopru", "isletim"],
  "timezone": "Europe/Istanbul",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "ds",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "label": "Veri kaynağı"
      },
      {
        "name": "servis",
        "type": "query",
        "label": "Servis",
        "datasource": {
          "type": "prometheus",
          "uid": "${ds}"
        },
        "query": {
          "query": "label_values(kopru_http_istek_suresi_seconds_count, service_name)",
          "refId": "servis"
        },
        "definition": "label_values(service_name)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "İstek hızı (istek/sn)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (service_name) (rate(kopru_http_istek_suresi_seconds_count{service_name=~\"$servis\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx oranı",
      "description": "Uyarı %2, kritik %10 (5 dk).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (service_name) (rate(kopru_http_5xx_total{service_name=~\"$servis\"}[5m])) / sum by (service_name) (rate(kopru_http_istek_suresi_seconds_count{service_name=~\"$servis\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Gecikme p50 / p95 / p99",
      "description": "p95 uyarı 1 sn, kritik 3 sn.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.5, sum by (service_name, le) (rate(kopru_http_istek_suresi_seconds_bucket{service_name=~\"$servis\"}[5m])))",
          "legendFormat": "p50 {{service_name}}",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.95, sum by (service_name, le) (rate(kopru_http_istek_suresi_seconds_bucket{service_name=~\"$servis\"}[5m])))",
          "legendFormat": "p95 {{service_name}}",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "histogram_quantile(0.99, sum by (service_name, le) (rate(kopru_http_istek_suresi_seconds_bucket{service_name=~\"$servis\"}[5m])))",
          "legendFormat": "p99 {{service_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "custom": {
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Durum sınıfına göre istek hızı",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (service_name, durum_sinifi) (rate(kopru_http_istek_suresi_seconds_count{service_name=~\"$servis\"}[5m]))",
          "legendFormat": "{{service_name}} {{durum_sinifi}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "En yavaş rotalar (p95)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "topk(10, histogram_quantile(0.95, sum by (yontem, rota, le) (rate(kopru_http_istek_suresi_seconds_bucket{service_name=~\"$servis\"}[5m]))))",
          "legendFormat": "{{yontem}} {{rota}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "5xx veren rotalar",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "topk(10, sum by (yontem, rota) (rate(kopru_http_5xx_total{service_name=~\"$servis\"}[5m])))",
          "legendFormat": "{{yontem}} {{rota}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "İptal listesi kontrolü atlandı (fail-open)",
      "description": "ADR 0008. Sıfırdan farklı her değer güvenlik uyarısıdır (KopruIptalKontrolAtlandi).",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (service_name) (increase(kopru_iptal_kontrol_atlandi_total{service_name=~\"$servis\"}[5m]))",
          "legendFormat": "{{service_name}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Push gönderim sonucu",
      "description": "Başarısız oranı %10 üstü: KopruBildirimGonderimHatasi.",
      "datasource": {
        "type": "prometheus",
        "uid": "${ds}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${ds}"
          },
          "expr": "sum by (sonuc) (increase(kopru_bildirim_gonderim_total[15m]))",
          "legendFormat": "{{sonuc}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        }
      }
    }
  ]
}
