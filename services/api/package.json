{
  "name": "@kopru/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "api servisi",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate-cli.ts migrate",
    "db:generate": "tsx src/db/migrate-cli.ts generate"
  },
  "dependencies": {
    "@kopru/contracts": "workspace:*",
    "@kopru/service-kit": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "fastify-plugin": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "jose": "catalog:",
    "nodemailer": "catalog:",
    "postgres": "catalog:",
    "uuidv7": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@kopru/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
