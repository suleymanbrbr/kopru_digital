# kopru_digital - ortam degiskenleri
# Kopyala: cp .env.example .env
# Her servis `<SERVIS>_<ANAHTAR>` (ornegin API_DATABASE_URL) degiskenini
# `<ANAHTAR>` degiskeninden once okur. Boylece tek .env dosyasi dort servisi besler.
# Uretimde her konteyner yalnizca kendi (oneksiz) degiskenlerini alir.

# --- Genel -------------------------------------------------------------
# development | test | production
NODE_ENV=development
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Dinlenecek adres (konteynerde 0.0.0.0)
HOST=0.0.0.0

# --- Servis portlari ---------------------------------------------------
API_PORT=4000
MOTIVASYON_PORT=4001
BILDIRIM_PORT=4002
MEDYA_PORT=4003

# --- PostgreSQL (her servisin kendi veritabani ve kullanicisi vardir) ---
# Opsiyonel: tanimli degilse /ready DB kontrolu yapilmaz ve DB acilmaz.
# api: uygulama api_app (RLS'e tabi), sistem isleri api_sistem (BYPASSRLS), migration api (db sahibi).
API_DATABASE_URL=postgres://api_app:api_app@localhost:5432/api
API_DATABASE_SISTEM_URL=postgres://api_sistem:api_sistem@localhost:5432/api
API_DATABASE_OWNER_URL=postgres://api:api@localhost:5432/api
MOTIVASYON_DATABASE_URL=postgres://motivasyon:motivasyon@localhost:5432/motivasyon
BILDIRIM_DATABASE_URL=postgres://bildirim:bildirim@localhost:5432/bildirim
# medya: uygulama medya_app (RLS'e tabi), sistem isleri medya_sistem (BYPASSRLS), migration medya (db sahibi).
MEDYA_DATABASE_URL=postgres://medya_app:medya_app@localhost:5432/medya
MEDYA_DATABASE_SISTEM_URL=postgres://medya_sistem:medya_sistem@localhost:5432/medya
MEDYA_DATABASE_OWNER_URL=postgres://medya:medya@localhost:5432/medya
# Baglanti havuzu ust siniri
DATABASE_POOL_MAX=10

# --- NATS JetStream ----------------------------------------------------
# Opsiyonel: tanimli degilse /ready NATS kontrolu yapilmaz, outbox relay calismaz.
NATS_URL=nats://localhost:4222

# --- Kimlik dogrulama (JWT / JWKS) -------------------------------------
# true ise /health ve /ready disindaki tum rotalar Bearer JWT ister.
AUTH_ENABLED=false
# api kimlik dogrulamasinin sahibidir ve kendi anahtarlariyla yerinde dogrular: daima acik olmali.
API_AUTH_ENABLED=true
# AUTH_ENABLED=true iken zorunlu (diger servisler): api'nin JWKS adresi
JWKS_URL=http://localhost:4000/.well-known/jwks.json
# iss / aud dogrulamasi. api bu degerlerle imzalar: iss = JWT_ISSUER (varsayilan API_PUBLIC_URL), aud = kopru
JWT_ISSUER=http://localhost:4000
JWT_AUDIENCE=kopru

# --- api kimlik (hesap modulu) -----------------------------------------
# Herkese acik taban adres: Better Auth baseURL ve JWT iss varsayilani (JWT_ISSUER ile ezilir).
API_PUBLIC_URL=http://localhost:4000
# Web uygulamasinin taban adresi: davet baglantilari ${API_WEB_URL}/davet/<belirtec> olur (e-posta dogrulama baglantisi ${API_WEB_URL}/eposta-dogrula).
API_WEB_URL=http://localhost:3000
# >= 32 karakter. Better Auth imza sirri + JWKS ozel anahtar sifreleme anahtarinin kaynagi.
# Uretimde zorunlu ve gizli yoneticiden gelir; gelistirmede varsayilan kullanilir.
# API_BETTER_AUTH_SECRET=
# OTP SMS saglayicisi. `log`: kod API logunda gorunur (yalnizca gelistirme). Gercek Netgsm bildirim ile gelir.
API_SMS_SAGLAYICI=log
# E-posta (dogrulama, davet). `log`: gonderilmez, yalnizca iliski kimligi loglanir. `smtp`: asagidaki SMTP_* ile gonderir
# (yerelde Mailpit: localhost:1025, arayuz http://localhost:8025). Uretim gonderimi bildirim servisine tasinacak.
API_EPOSTA_SAGLAYICI=log
# API_EPOSTA_GONDEREN=Köprü <no-reply@kopru.local>
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# Apple / Google girisi: her ikisi de tanimliysa (id + secret) saglayici acilir, aksi halde kapali.
# API_GOOGLE_CLIENT_ID=
# API_GOOGLE_CLIENT_SECRET=
# API_APPLE_CLIENT_ID=
# API_APPLE_CLIENT_SECRET=
# Ders kaydi (Zoom kayit) parolalarini AES-256-GCM ile sifreleyen anahtar: 32 bayt, base64 (openssl rand -base64 32).
# Asagidaki deger YALNIZCA gelistirme icindir; uretimde gizli yoneticiden gelen kendi anahtarin kullanilir.
# Tanimli degilse api acilir, parola yazilirken/okunurken 503 kaynak_sifreleme_yapilandirilmamis doner.
API_KAYNAK_PAROLA_ANAHTARI=3p+O6VwOWiCQLYoyrCe9w/HPIFGaYewkci2CI4WCK2c=
# Soru sor: soru/cevap eklerinin okuma adresleri icin medya servisinin taban adresi (ic uc /ic/okuma-adresleri,
# servis JWT'si). Tanimli degilse soru yine doner, ek adresleri null ve adres_alinamadi true olur.
API_MEDYA_URL=http://localhost:4003
# API_MEDYA_ZAMAN_ASIMI_MS=2000
# db:migrate sirasinda api_app / api_sistem rol sifrelerini ayarlar (yalnizca gelistirme/test).
# API_APP_PASSWORD=
# API_SISTEM_PASSWORD=

# --- medya (dosya yukleme, nesne depolama) -------------------------------
# medya kimlik dogrulamasini api'nin JWKS'iyle yapar (kullanici JWT'si + /ic/* icin servis JWT'si).
MEDYA_AUTH_ENABLED=true
# S3 uyumlu depolama: servis ici adres ve istemciye verilen presigned adresin ana makinesi AYRI ayarlanir
# (simulator/tarayici localhost:9000'e ulasir; konteynerde ic adres farkli olabilir). S3_ENDPOINT yukarida (genel).
MEDYA_S3_ENDPOINT=http://localhost:9000
MEDYA_S3_GENEL_ENDPOINT=http://localhost:9000
MEDYA_S3_ACCESS_KEY_ID=kopru
MEDYA_S3_SECRET_ACCESS_KEY=kopru-dev-secret
MEDYA_S3_REGION=us-east-1
# Gelistirmede acilista kova ve CORS (CORS_ORIGINS) otomatik ayarlanir; uretimde altyapi yonetir (varsayilan kapali).
# MEDYA_S3_KOVA_YAPILANDIR=true
# Abonelik olayi gelene kadar kurum basina varsayilan depolama kotasi (bayt); varsayilan 5 GiB.
# MEDYA_VARSAYILAN_KOTA_BAYT=5368709120
# Worker: ayni anda islenen dosya sayisi ve bos kuyruk yoklama araligi (ms).
# MEDYA_ISLEME_ESZAMANLILIK=2
# MEDYA_ISLEME_ARALIK_MS=1000
# Bakim turu (silme isi, yukleme zaman asimi, yetim kurali) araligi; varsayilan 300000 (5 dk).
# MEDYA_BAKIM_ARALIK_MS=300000
# db:migrate sirasinda medya_app / medya_sistem rol sifrelerini ayarlar (yalnizca gelistirme/test).
# MEDYA_APP_PASSWORD=
# MEDYA_SISTEM_PASSWORD=

# --- HTTP --------------------------------------------------------------
# Virgulle ayrilmis izinli origin listesi. Bos ise CORS kapali.
# medya servisi bu listeyi S3 kovasinin CORS kurali olarak da yazar: web (apps/web) fotograf/ses dosyasini
# TARAYICIDAN dogrudan presigned adrese PUT eder ve cizim icin GET eder; web origin'i (ornek
# http://localhost:3000) burada bulunmali, aksi halde yukleme ve cizim "CORS" ile basarisiz olur.
CORS_ORIGINS=http://localhost:3000

# --- Web (apps/web) BFF ------------------------------------------------
# Web sunucusu api'ye API_URL (varsayilan http://localhost:4000), medyaya MEDYA_URL ile baglanir
# (/api/medya/dosyalar* -> MEDYA_URL/v1/dosyalar*; varsayilan http://localhost:4003).
# API_URL=http://localhost:4000
# MEDYA_URL=http://localhost:4003
# Istemci IP'sine X-Forwarded-For ile guvenilen proxy adresleri (virgulle IP/CIDR; ADR 0009).
# Bos = hicbiri (yerelde bos birakin). '*' ve 'true' reddedilir. Uretimde yalniz ozel agdaki
# proxy/web kaynak adresleri, orn. 10.0.0.0/24.
TRUST_PROXY=
# Dakikada istemci basina istek siniri
RATE_LIMIT_MAX=300
# /openapi.json yayinlansin mi (varsayilan: production disinda true)
OPENAPI_ENABLED=true

# --- OpenTelemetry -----------------------------------------------------
# Tanimli degilse telemetri kapali. Lokal: grafana/otel-lgtm
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Test --------------------------------------------------------------
# Verilirse DB'li testler calisir, verilmezse acik mesajla atlanir.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/kopru_test

# --- Docker compose (infra/docker/compose.yaml) tarafindan kullanilan --
# Yalnizca lokal gelistirme; uretim sirlari buraya yazilmaz.
MINIO_ROOT_USER=kopru
MINIO_ROOT_PASSWORD=kopru-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=medya
SMTP_HOST=localhost
SMTP_PORT=1025

# Web sunucusunun onundeki guvenilen proxy sayisi (ADR 0009). 0: proxy yok; gercek istemci IP'si api'ye iletilmez.
# Canlida Kamal proxy arkasinda 1.
WEB_GUVENILEN_PROXY_SAYISI=0
