# Kamal sirlari ORNEGI. Gercek dosyalari olusturun (git'e GIRMEZ, .gitignore'da):
#   cp .kamal/secrets.example .kamal/secrets-common
#   cp .kamal/secrets.example .kamal/secrets.staging       # ve .kamal/secrets.production
# Dosya kabuk bicimindedir; DEGERLERI burada tutmayin, sir yoneticisinden (parola yoneticisi / sir deposu)
# komutla okuyun. Asagidaki `sir-oku` bir YER TUTUCUDUR: kullandiginiz aracin komutuyla degistirin
# (ornegin `kamal secrets fetch ...` adaptorleri veya kurumunuzun sir deposu CLI'si). Sağlayıcı seçilmedi.
#
# Ad kurali: <SERVIS>_<KONTEYNER_DEGISKENI>. Kamal bunu konteynere onekSIZ verir (API_DATABASE_URL -> DATABASE_URL).
# Her degiskenin anlami, zorunlu/istege bagli durumu: docs/isletim/dagitim.md "Sir ve ortam degiskenleri".
# Ornek deger yazilmaz.

# --- Ortak (secrets-common) ------------------------------------------------------------------------
KAMAL_REGISTRY_PASSWORD=$(sir-oku "kopru/kayit-defteri")

# --- Her hedef icin (secrets.staging / secrets.production) -----------------------------------------
# Goc (yalniz .kamal/hooks/pre-deploy okur; uygulama konteynerine girmez): <servis>_owner'a gecebilen kullanici
API_DATABASE_OWNER_URL=$(sir-oku "kopru/api/db-owner-url")
MOTIVASYON_DATABASE_OWNER_URL=$(sir-oku "kopru/motivasyon/db-owner-url")
BILDIRIM_DATABASE_OWNER_URL=$(sir-oku "kopru/bildirim/db-owner-url")
MEDYA_DATABASE_OWNER_URL=$(sir-oku "kopru/medya/db-owner-url")

# api
API_DATABASE_URL=$(sir-oku "kopru/api/db-app-url")             # api_app (RLS'e tabi)
API_DATABASE_SISTEM_URL=$(sir-oku "kopru/api/db-sistem-url")   # api_sistem (BYPASSRLS)
API_BETTER_AUTH_SECRET=$(sir-oku "kopru/api/better-auth-secret")
API_KAYNAK_PAROLA_ANAHTARI=$(sir-oku "kopru/api/kaynak-parola-anahtari")
API_SMTP_USER=$(sir-oku "kopru/api/smtp-user")
API_SMTP_PASS=$(sir-oku "kopru/api/smtp-pass")
API_IYZICO_API_KEY=$(sir-oku "kopru/api/iyzico-api-key")
API_IYZICO_SECRET_KEY=$(sir-oku "kopru/api/iyzico-secret-key")
API_REVENUECAT_WEBHOOK_SIRRI=$(sir-oku "kopru/api/revenuecat-webhook-sirri")
API_GOOGLE_CLIENT_SECRET=$(sir-oku "kopru/api/google-client-secret")
API_APPLE_CLIENT_SECRET=$(sir-oku "kopru/api/apple-client-secret")

# motivasyon
MOTIVASYON_DATABASE_URL=$(sir-oku "kopru/motivasyon/db-app-url")
MOTIVASYON_DATABASE_SISTEM_URL=$(sir-oku "kopru/motivasyon/db-sistem-url")

# bildirim
BILDIRIM_DATABASE_URL=$(sir-oku "kopru/bildirim/db-app-url")
BILDIRIM_DATABASE_SISTEM_URL=$(sir-oku "kopru/bildirim/db-sistem-url")
BILDIRIM_EXPO_ERISIM_BELIRTECI=$(sir-oku "kopru/bildirim/expo-erisim-belirteci")

# medya
MEDYA_DATABASE_URL=$(sir-oku "kopru/medya/db-app-url")
MEDYA_DATABASE_SISTEM_URL=$(sir-oku "kopru/medya/db-sistem-url")
MEDYA_S3_ACCESS_KEY_ID=$(sir-oku "kopru/medya/s3-access-key-id")
MEDYA_S3_SECRET_ACCESS_KEY=$(sir-oku "kopru/medya/s3-secret-access-key")

# web ve admin: gizli ortam degiskeni yok (api adreslerini ve proxy sayisini deploy.<hedef>.yml tasir).
