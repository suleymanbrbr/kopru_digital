{
  "name": "@kopru/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web uygulamasi (Next.js): kurum, ogretmen ve ogrenci arayuzu",
  "scripts": {
    "hazirla": "tsx scripts/hazirla.ts",
    "predev": "pnpm run hazirla",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm run hazirla",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "pretest": "pnpm run hazirla",
    "test": "vitest run",
    "e2e": "playwright test",
    "ekran": "playwright test --config playwright.ekran.config.ts",
    "e2e:gercek": "playwright test --config playwright.gercek.config.ts"
  },
