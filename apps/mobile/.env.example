# Yerelde kopyalayin: cp .env.example .env
# 1 = sahte (mock) API; backend olmadan tum akislar calisir. Giris kodu: 123456
EXPO_PUBLIC_API_MOCK=1
# Gercek API (mock kapaliyken). Gercek istemci (packages/api-client) baglaninca kullanilir.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Uygulama kimligi (app.config.ts okur). Varsayilanlar yer tutucudur.
APP_BUNDLE_ID=com.koprudigital.app
APP_ADI=Köprü
APP_SCHEME=kopru
