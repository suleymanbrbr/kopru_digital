{
  "name": "@kopru/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "kopru_digital mobil uygulama (Expo, iOS + Android)",
  "main": "expo-router/entry",
  "scripts": {
    "deps:build": "turbo run build --filter=@kopru/mobile^...",
    "prestart": "pnpm run deps:build",
    "start": "expo start --dev-client",
    "preios": "pnpm run deps:build",
    "ios": "expo run:ios",
    "preandroid": "pnpm run deps:build",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild:native": "expo prebuild --no-install --clean",
    "karakter:uret": "node scripts/karakter-uret.mjs",
    "doctor": "expo-doctor",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "jest"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@kopru/api-client": "workspace:*",
    "@kopru/contracts": "workspace:*",
    "@kopru/i18n": "workspace:*",
    "@kopru/ui-tokens": "workspace:*",
    "@react-native-community/netinfo": "12.0.1",
    "@rive-app/react-native": "0.5.12",
    "@shopify/react-native-skia": "2.14.0",
    "@tanstack/query-async-storage-persister": "5.107.1",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-persist-client": "5.107.1",
    "expo": "~58.0.23",
    "expo-audio": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "marked": "catalog:",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
