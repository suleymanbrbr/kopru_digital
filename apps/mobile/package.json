    "uuidv7": "catalog:"
  },
  "devDependencies": {
    "@kopru/config": "workspace:*",
    "@types/jest": "^30.0.0",
    "@types/node": "catalog:",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "19.3.1",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "catalog:",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
